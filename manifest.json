{
  "manifest_version": 3,
  "name": "나만의 광고 차단기",
  "version": "1.0",
  "description": "원하는 광고 도메인과 요소를 차단하는 확장프로그램",
  
  // 확장프로그램 툴바에 표시될 아이콘 설정
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },

  // 확장프로그램 관리 페이지 전체에서 쓰일 대표 아이콘 설정
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },

  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
