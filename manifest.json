{
  "manifest_version": 3,
  "name": "나만의 광고 차단기",
  "version": "1.0",
  "description": "원하는 광고 도메인과 요소를 차단하는 확장프로그램",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
